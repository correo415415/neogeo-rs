<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_rom_card"
    android:orientation="horizontal"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_thumb">

        <TextView
            android:id="@+id/rom_thumb_letter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/brand_amber"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="M" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rom_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fg_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="mslug" />

        <TextView
            android:id="@+id/rom_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/fg_tertiary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Cartridge zip" />
    </LinearLayout>

    <TextView
        android:id="@+id/rom_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_chip_secondary"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/brand_amber"
        android:textSize="11sp"
        android:textStyle="bold"
        android:text="BIOS"
        android:visibility="gone" />
</LinearLayout>
