<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_rom_card"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_thumb">

        <TextView
            android:id="@+id/rom_thumb_letter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/brand_amber"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="M" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rom_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fg_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Metal Slug 3" />

        <TextView
            android:id="@+id/rom_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/fg_tertiary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="2000 · SNK · 42.1 MB" />
    </LinearLayout>

    <TextView
        android:id="@+id/rom_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_chip_secondary"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/brand_amber"
        android:textSize="11sp"
        android:textStyle="bold"
        android:text="BIOS"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/fg_tertiary"
        android:textSize="18sp"
        android:importantForAccessibility="no"
        android:text="›" />
</LinearLayout>
