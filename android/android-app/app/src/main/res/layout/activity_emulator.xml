<?xml version="1.0" encoding="utf-8"?>
<!--
  EmulatorActivity layout (LANDSCAPE).
  Sólo se muestra durante el juego. El layout es liviano: SurfaceView
  ocupando todo, HUD discreto arriba y dos pads laterales (joystick/
  flechas + ABCD). Pantalla P2 opcional centrada según preferencias.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.pydmg.neogeo.EmulatorView
        android:id="@+id/emulator_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD superior (chips compactos) -->
    <HorizontalScrollView
        android:id="@+id/top_hud_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:fillViewport="false"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/top_hud_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_hud_menu"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/btn_chip"
                android:text="@string/hud_menu"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <Button
                android:id="@+id/btn_coin_p1"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_chip"
                android:text="1C"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btn_select_p1"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_chip"
                android:text="1SEL"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btn_start_p1"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_chip"
                android:text="1P"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- P1 izquierda -->
    <FrameLayout
        android:id="@+id/p1_left_controls"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="18dp">

        <RelativeLayout
            android:id="@+id/dpad_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/dpad_up"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_pill"
                android:text="▲"
                android:textColor="@color/ctrl_text" />

            <Button
                android:id="@+id/dpad_down"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:background="@drawable/btn_pill"
                android:text="▼"
                android:textColor="@color/ctrl_text" />

            <Button
                android:id="@+id/dpad_left"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_pill"
                android:text="◀"
                android:textColor="@color/ctrl_text" />

            <Button
                android:id="@+id/dpad_right"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/btn_pill"
                android:text="▶"
                android:textColor="@color/ctrl_text" />
        </RelativeLayout>

        <com.pydmg.neogeo.JoystickView
            android:id="@+id/joystick_p1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- P1 derecha -->
    <RelativeLayout
        android:id="@+id/abcd_pad"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp">

        <Button
            android:id="@+id/btn_a"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_round"
            android:text="A"
            android:textColor="@color/ctrl_text" />

        <Button
            android:id="@+id/btn_b"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/btn_round"
            android:text="B"
            android:textColor="@color/ctrl_text" />

        <Button
            android:id="@+id/btn_c"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:background="@drawable/btn_round"
            android:text="C"
            android:textColor="@color/ctrl_text" />

        <Button
            android:id="@+id/btn_d"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/btn_round"
            android:text="D"
            android:textColor="@color/ctrl_text" />
    </RelativeLayout>

    <!-- Overlay de menú in-game (pausa + salir) -->
    <FrameLayout
        android:id="@+id/pause_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="22dp">

            <TextView
                android:id="@+id/pause_game_title"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/hud_pause" />

            <TextView
                android:id="@+id/pause_game_subtitle"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/brand_amber"
                android:text="@string/hud_pause" />

            <Button
                android:id="@+id/btn_resume"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_primary"
                android:textColor="@color/bg_root"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:text="@string/pause_resume" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_save_state"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/fg_primary"
                    android:textAllCaps="false"
                    android:text="@string/pause_save_state" />

                <Button
                    android:id="@+id/btn_load_state"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/fg_primary"
                    android:textAllCaps="false"
                    android:text="@string/pause_load_state" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                android:background="@color/divider" />

            <Button
                android:id="@+id/btn_back_to_library"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/brand_red"
                android:textAllCaps="false"
                android:text="@string/hud_back_to_library" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
