      orphan file without failing the build. Safe to remove once the
      user has deleted the stale layout.
    -->
    <color name="panel_bg">#13110F</color>
    <color name="panel_bg_strong">#1C1815</color>
    <color name="panel_stroke">#22FFFFFF</color>
