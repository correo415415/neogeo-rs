<?xml version="1.0" encoding="utf-8"?>
<!--
  EmulatorActivity layout (LANDSCAPE).
  Sólo se muestra durante el juego. El layout es liviano: SurfaceView
  ocupando todo, HUD discreto arriba y dos pads laterales (joystick/
  flechas + ABCD). Pantalla P2 opcional centrada según preferencias.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.pydmg.neogeo.EmulatorView
        android:id="@+id/emulator_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD superior (chips compactos) -->
    <HorizontalScrollView
        android:id="@+id/top_hud_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:fillViewport="false"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/top_hud_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_hud_menu"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/btn_chip"
                android:text="@string/hud_menu"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <Button
                android:id="@+id/btn_coin_p1"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_chip"
                android:text="1C"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btn_select_p1"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_chip"
                android:text="1SEL"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btn_start_p1"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_chip"
                android:text="1P"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btn_coin_p2"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/btn_chip_secondary"
                android:text="2C"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_start_p2"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_chip_secondary"
                android:text="2P"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- P1 izquierda -->
    <FrameLayout
        android:id="@+id/p1_left_controls"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="18dp">

        <RelativeLayout
            android:id="@+id/dpad_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/dpad_up"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_pill"
                android:text="▲"
                android:textColor="@color/ctrl_text" />

            <Button
                android:id="@+id/dpad_down"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:background="@drawable/btn_pill"
                android:text="▼"
                android:textColor="@color/ctrl_text" />

            <Button
                android:id="@+id/dpad_left"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_pill"
                android:text="◀"
                android:textColor="@color/ctrl_text" />

            <Button
                android:id="@+id/dpad_right"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/btn_pill"
                android:text="▶"
                android:textColor="@color/ctrl_text" />
        </RelativeLayout>

        <com.pydmg.neogeo.JoystickView
            android:id="@+id/joystick_p1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- P1 derecha -->
    <RelativeLayout
        android:id="@+id/abcd_pad"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp">

        <Button
            android:id="@+id/btn_a"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_round"
            android:text="A"
            android:textColor="@color/ctrl_text" />

        <Button
            android:id="@+id/btn_b"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/btn_round"
            android:text="B"
            android:textColor="@color/ctrl_text" />

        <Button
            android:id="@+id/btn_c"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:background="@drawable/btn_round"
            android:text="C"
            android:textColor="@color/ctrl_text" />

        <Button
            android:id="@+id/btn_d"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/btn_round"
            android:text="D"
            android:textColor="@color/ctrl_text" />
    </RelativeLayout>

    <!-- P2 izquierda (compacto, opcional) -->
    <FrameLayout
        android:id="@+id/p2_left_controls"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="72dp"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/dpad_p2_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/dpad2_up"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_pill_small"
                android:text="▲"
                android:textColor="@color/ctrl_text" />

            <Button
                android:id="@+id/dpad2_down"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:background="@drawable/btn_pill_small"
                android:text="▼"
                android:textColor="@color/ctrl_text" />

            <Button
                android:id="@+id/dpad2_left"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_pill_small"
                android:text="◀"
                android:textColor="@color/ctrl_text" />

            <Button
                android:id="@+id/dpad2_right"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/btn_pill_small"
                android:text="▶"
                android:textColor="@color/ctrl_text" />
        </RelativeLayout>

        <com.pydmg.neogeo.JoystickView
            android:id="@+id/joystick_p2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <RelativeLayout
        android:id="@+id/p2_abcd_pad"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="72dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn2_a"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_round_small"
            android:text="A"
            android:textColor="@color/ctrl_text" />

        <Button
            android:id="@+id/btn2_b"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/btn_round_small"
            android:text="B"
            android:textColor="@color/ctrl_text" />

        <Button
            android:id="@+id/btn2_c"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:background="@drawable/btn_round_small"
            android:text="C"
            android:textColor="@color/ctrl_text" />

        <Button
            android:id="@+id/btn2_d"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/btn_round_small"
            android:text="D"
            android:textColor="@color/ctrl_text" />
    </RelativeLayout>

    <!-- Overlay de menú in-game (pausa + salir) -->
    <FrameLayout
        android:id="@+id/pause_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="22dp">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hud_pause" />

            <Button
                android:id="@+id/btn_resume"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_primary"
                android:textColor="@color/bg_root"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:text="Continuar" />

            <Button
                android:id="@+id/btn_back_to_library"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:text="@string/hud_back_to_library" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
