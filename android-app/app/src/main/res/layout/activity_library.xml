<?xml version="1.0" encoding="utf-8"?>
<!--
  LibraryActivity layout (PORTRAIT).
  Frontend de emulación con dos secciones conmutables ("Biblioteca" /
  "Ajustes") + cabecera + acción flotante. Diseñado portrait-first; la
  actividad fuerza `screenOrientation="portrait"` en el manifest.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root_gradient"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:liftOnScroll="false"
        app:elevation="0dp">

        <!-- Header con título + chip de BIOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/text_brand"
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/app_subtitle" />

            <Button
                android:id="@+id/btn_bios_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="40dp"
                android:background="@drawable/btn_chip"
                android:text="@string/bios_missing"
                android:textColor="@color/fg_primary"
                android:textAllCaps="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="@color/brand_amber"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/fg_primary"
            app:tabTextColor="@color/fg_tertiary"
            app:tabMode="fixed"
            app:tabGravity="fill" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido conmutable -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ====================== BIBLIOTECA ====================== -->
        <LinearLayout
            android:id="@+id/library_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="220dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/library_count"
                    style="@style/Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 cartuchos detectados" />

                <Button
                    android:id="@+id/btn_rescan_top"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_chip_secondary"
                    android:textColor="@color/fg_primary"
                    android:textAllCaps="false"
                    android:text="@string/library_scan" />
            </LinearLayout>

            <EditText
                android:id="@+id/edit_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:hint="@string/library_search_hint"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/fg_primary"
                android:textColorHint="@color/fg_tertiary"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:autofillHints="off"
                android:importantForAutofill="no" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/library_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    android:scrollbars="vertical" />

                <LinearLayout
                    android:id="@+id/library_empty_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/library_empty_title"
                        android:gravity="center" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/library_empty_body"
                        android:gravity="center" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ====================== AJUSTES ====================== -->
        <ScrollView
            android:id="@+id/settings_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Sección Controles -->
                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_section_controls" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_use_joystick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_use_joystick"
                        android:textColor="@color/fg_primary"
                        android:minHeight="48dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@color/divider" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_local_mp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_local_multiplayer"
                        android:textColor="@color/fg_primary"
                        android:minHeight="48dp" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/settings_opacity" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_opacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.25"
                        android:valueTo="1.0"
                        android:stepSize="0.05"
                        android:value="0.7" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_scale" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_scale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.75"
                        android:valueTo="1.35"
                        android:stepSize="0.05"
                        android:value="1.0" />
                </LinearLayout>

                <!-- Sección Vídeo -->
                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/settings_section_video" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_crop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_crop"
                        android:textColor="@color/fg_primary"
                        android:minHeight="48dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@color/divider" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_smooth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_smooth"
                        android:textColor="@color/fg_primary"
                        android:minHeight="48dp" />
                </LinearLayout>

                <!-- Sección Almacenamiento -->
                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/settings_section_storage" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_folder" />

                    <TextView
                        android:id="@+id/text_folder_value"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="—" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_settings_pick_folder"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_secondary"
                            android:textColor="@color/fg_primary"
                            android:textAllCaps="false"
                            android:text="@string/settings_pick_folder" />

                        <Button
                            android:id="@+id/btn_settings_rescan"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/btn_secondary"
                            android:textColor="@color/fg_primary"
                            android:textAllCaps="false"
                            android:text="@string/settings_rescan" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/divider" />

                    <Button
                        android:id="@+id/btn_settings_pick_bios"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/btn_secondary"
                        android:textColor="@color/fg_primary"
                        android:textAllCaps="false"
                        android:text="@string/bios_pick" />
                </LinearLayout>

                <!-- Sección Acerca de -->
                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/settings_section_about" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_card"
                    android:text="@string/settings_about_body" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Acciones inferiores: cargar zip / elegir carpeta -->
    <LinearLayout
        android:id="@+id/bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom"
        android:padding="16dp"
        android:background="#CC0A0908">

        <Button
            android:id="@+id/btn_load_zip"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:textColor="@color/bg_root"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:text="@string/library_load_zip" />

        <Button
            android:id="@+id/btn_pick_folder"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/fg_primary"
            android:textAllCaps="false"
            android:text="@string/library_pick_folder" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
